// The state machine of the lamp. The descriptor attaches it to the object "lamp".
//
// A press in the domain "switch" turns the lamp on and off. The lamp always comes on at
// the full power of its bulb. While it is on, a dim event turns the dimmer one step.
// With bright set to true the bulb gets 10 W more, up to its maxWatts. With bright set
// to false it gets 10 W less, down to 0 W. Switching the lamp off forgets the dimming.
// A smash in the domain "service" breaks the lamp, whether it is on or off. The bulb
// goes dark, and the spare bulb drops out of the model.
//
// "on" has three inner states. The transitions that start at "on" also apply while the
// lamp is in one of them, so a press switches the lamp off from any of them, and a smash
// breaks it in any of them.
STATEMACHINE ATTACHED TO "Lamp" {
    STATES {
        INITIAL STATE "off" {
            ENTRY {
                SET("mode", "off")
                SET("bulb->lit", "false")
                SET("bulb->watts", "0")
            }
        }
        STATE "on" {
            ENTRY {
                SET("mode", "on")
                SET("bulb->lit", "true")
            }
            STATE "full" {
                ENTRY {
                    SET("bulb->watts", EVAL { return $(bulb->maxWatts) })
                }
            }
            STATE "brighter" {
                ENTRY {
                    SET("bulb->watts", EVAL { return $(bulb->watts) + 10 })
                }
            }
            STATE "dimmer" {
                ENTRY {
                    SET("bulb->watts", EVAL { return $(bulb->watts) - 10 })
                }
            }
        }
        STATE "broken" {
            ENTRY {
                DROPOBJ("spare")
                SET("mode", "broken")
                SET("bulb->lit", "false")
                SET("bulb->watts", "0")
            }
        }
    }
    TRANSITIONS {
        TRANSITION "off" -> "full" {
            CONDITION { EVENT("switch", "press") }
        }
        TRANSITION "on" -> "off" {
            CONDITION { EVENT("switch", "press") }
        }
        // One step brighter, unless the bulb already burns at its full power.
        TRANSITION "on" -> "brighter" {
            CONDITION {
                EVENT("switch", "dim")
                VALUE("event->bright")
                EVAL { return $(bulb->watts) + 10 <= $(bulb->maxWatts) }
            }
        }
        // One step dimmer, unless the bulb is already down to 0 W.
        TRANSITION "on" -> "dimmer" {
            CONDITION {
                EVENT("switch", "dim")
                EVAL { return not $(event->bright) }
                EVAL { return $(bulb->watts) - 10 >= 0 }
            }
        }
        TRANSITION "off" -> "broken" {
            CONDITION { EVENT("service", "smash") }
        }
        TRANSITION "on" -> "broken" {
            CONDITION { EVENT("service", "smash") }
        }
    }
}

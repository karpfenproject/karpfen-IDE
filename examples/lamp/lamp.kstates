// The state machine of the lamp. The descriptor attaches it to the object "lamp".
// A press in the domain "switch" turns the lamp on and off. While it is on, a dim event
// whose payload has bright set to true gives full power. A smash in the domain "service"
// breaks the lamp while it is off and drops the spare bulb from the model.
STATEMACHINE ATTACHED TO "Lamp" {
    STATES {
        INITIAL STATE "off" {
            ENTRY {
                SET("mode", "off")
                SET("bulb->lit", "false")
                APPEND("log", "off")
            }
        }
        STATE "on" {
            ENTRY {
                SET("mode", "on")
                SET("bulb->lit", "true")
                APPEND("log", "on")
            }
            STATE "full power" {
                ENTRY {
                    SET("bulb->watts", "100")
                    APPEND("log", "full power at 100 W")
                }
            }
        }
        STATE "broken" {
            ENTRY {
                DROPOBJ("spare")
                SET("mode", "broken")
                APPEND("log", "broken")
            }
        }
    }
    TRANSITIONS {
        TRANSITION "off" -> "on" {
            CONDITION { EVENT("switch", "press") }
        }
        TRANSITION "on" -> "off" {
            CONDITION { EVENT("switch", "press") }
        }
        TRANSITION "on" -> "full power" NOT LOOPING {
            CONDITION {
                EVENT("switch", "dim")
                VALUE("event->bright")
            }
        }
        TRANSITION "off" -> "broken" {
            CONDITION { EVENT("service", "smash") }
        }
    }
}

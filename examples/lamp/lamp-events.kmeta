// The events of the lamp example. Each type names an event, and its properties are the
// payload the event carries. The state machines decide the domain of each event:
// press and dim arrive in the domain "switch", smash in the domain "service".
type "press" "Presses the wall switch" {
}
type "dim" "Turns the dimmer one step: 10 W brighter when bright is true, 10 W dimmer when it is false" {
    prop("bright", "boolean")
}
type "smash" "Breaks the lamp for good" {
}

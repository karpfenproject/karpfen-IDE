// The metamodel of the lamp example: the types the model is made of.
// A room holds a lamp and a wall switch. The lamp holds a bulb and a spare bulb,
// and it knows the switch it is wired to.
type "Bulb" "A light bulb. It burns with watts, which never exceeds maxWatts" {
    prop("maxWatts", "number")
    prop("watts", "number")
    prop("lit", "boolean")
}
type "Switch" "A wall switch" {
    prop("position", "string")
    prop("presses", list("string"))
}
type "Lamp" "A lamp with a bulb, a spare bulb and the switch it is wired to" {
    prop("mode", "string")
    prop("log", list("string"))
    has("bulb", "Bulb")
    has("spare", "Bulb")
    knows("control", "Switch")
}
type "Room" "The room the lamp stands in" {
    has("lamp", "Lamp")
    has("switch", "Switch")
}

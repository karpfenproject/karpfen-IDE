// The state machine of the room. The descriptor attaches it to the object "room".
//
// stock adds a new bulb to the shelf and attaches "glowing" to it by name. flicker exchanges
// the state machine of the bulb in the lamp for "flickering". replace screws a new bulb with the
// watts of the old one into the lamp. The old bulb leaves the model, which ends its state machine,
// and the new one gets "glowing" through the behaves after of its type.
STATEMACHINE ATTACHED TO "Room" {
    STATES {
        INITIAL STATE "ready" { }
        STATE "stocked" {
            ENTRY {
                APPENDOBJ("self", "spares", MACRO("new bulb", "lamp->bulb->watts")) ATTACH "glowing"
            }
        }
        STATE "flickering" {
            ENTRY {
                EXCHANGE("lamp->bulb", "flickering")
            }
        }
        STATE "replaced" {
            ENTRY {
                SETOBJ("lamp", "bulb", MACRO("new bulb", "lamp->bulb->watts"))
            }
        }
    }
    TRANSITIONS {
        TRANSITION "ready" -> "stocked" {
            CONDITION { EVENT("service", "stock") }
        }
        TRANSITION "ready" -> "flickering" {
            CONDITION { EVENT("service", "flicker") }
        }
        TRANSITION "ready" -> "replaced" {
            CONDITION { EVENT("service", "replace") }
        }
        TRANSITION "stocked" -> "ready" { }
        TRANSITION "flickering" -> "ready" { }
        TRANSITION "replaced" -> "ready" { }
    }
    MACROS {
        MACRO "new bulb" {
            TAKES("watts", "number")
            RETURNS("Bulb")
            DEFINITION {
                EVAL { return {"watts": $(watts), "lit": False} }
            }
        }
    }
}

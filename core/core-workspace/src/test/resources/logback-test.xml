<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test logging of core-workspace: only what karpfen-dsl-tools logs at WARN and above, the syntax errors its parsers
  report, goes to standard error, where the analyzer tests expect nothing because dsl-tools never sees broken text.
  Everything else stays silent, as without a logging backend.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.karpfen.dsl" level="WARN">
        <appender-ref ref="STDERR"/>
    </logger>
    <root level="OFF"/>
</configuration>

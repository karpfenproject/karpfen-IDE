<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging of the karpfen command-line tool. This is its only logging configuration. It logs WARN and above to the
  console only, on standard error. Standard output carries nothing but the report, so the report stays
  machine-readable in the JSON format.

  What karpfen-dsl-tools logs is off. It logs below the logger io.karpfen.dsl, which DslToolsLoggers names. Every
  problem dsl-tools finds reaches the report as a diagnostic anyway. The logger passes its events on to the root
  logger. So validate with the verbose option, which raises that logger to DEBUG for the run through
  LogbackLanguageToolsLog, also shows everything dsl-tools logs on standard error. Each such line names the file
  dsl-tools read in brackets after the logger. While dsl-tools reads a file, the mapped diagnostic context names that
  file under the key karpfen.file, which DslToolsLoggers names.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%-5level %logger{36} %replace([%X{karpfen.file}] ){'\[\] ', ''}- %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.karpfen.dsl" level="OFF"/>
    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>

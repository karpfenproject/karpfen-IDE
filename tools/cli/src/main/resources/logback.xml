<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging of the karpfen command-line tool, its only logging configuration: console only, WARN and above, on
  standard error. Standard output carries nothing but the report, so it stays machine-readable (JSON format).

  What karpfen-dsl-tools logs, below the logger io.karpfen.dsl (DslToolsLoggers names it), is off: every problem
  dsl-tools finds reaches the report as a diagnostic anyway. The logger passes its events on to the root logger, so
  validate with verbose, which raises it to DEBUG for the run (LogbackLanguageToolsLog), shows everything dsl-tools
  logs on standard error as well.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.karpfen.dsl" level="OFF"/>
    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test logging of tools/cli: console only, so no test ever writes into a real log directory. Takes precedence over
  src/main/resources/logback.xml on the test classpath. Like the production configuration, it turns what dsl-tools logs
  off and lets the logger of dsl-tools pass its events on to the console, where verbose validations show them, with
  the file dsl-tools read in brackets after the logger.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} %replace([%X{karpfen.file}] ){'\[\] ', ''}- %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.karpfen.dsl" level="OFF"/>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

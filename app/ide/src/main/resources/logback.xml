<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging of the karpfen IDE, its only logging configuration.

  The IDE's own logging: WARN and above on the console (standard error), INFO and above in the rolling file
  <IDE home>/logs/ide.log. The IDE home is the system property karpfen.ide.home, which the app's main sets from
  KARPFEN_IDE_HOME before the first logger exists, else ~/.karpfen-ide; SettingsLocations reads the same property, so
  settings and log always move together (launch smoke tests use a temporary home).

  What karpfen-dsl-tools logs, below the logger io.karpfen.dsl (DslToolsLoggers names it), never reaches the console:
  that logger logs at DEBUG and passes nothing on to the root logger. Every event goes to the rolling file
  <IDE home>/logs/dsl-tools.log, and its warnings and errors are also forwarded to ide.log (DslToolsThresholdFilter
  holds back the rest there). The composition root attaches one more appender to the same logger at runtime,
  LanguageToolsLogRouting, which fills the workbench's Language Tools Output, shown on demand.

  While dsl-tools reads a file, the mapped diagnostic context names it under karpfen.file (DslToolsLoggers names the
  key); both log files write it in brackets after the logger, and leave the brackets out for an event without it.

  Tests use the console-only src/test/resources/logback-test.xml instead.
-->
<configuration>
    <variable name="IDE_HOME" value="${karpfen.ide.home:-${user.home}/.karpfen-ide}"/>
    <variable name="LOG_DIRECTORY" value="${IDE_HOME}/logs"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIRECTORY}/ide.log</file>
        <filter class="io.karpfen.ide.app.logging.DslToolsThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIRECTORY}/ide.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} %replace([%X{karpfen.file}] ){'\[\] ', ''}- %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="DSL_TOOLS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIRECTORY}/dsl-tools.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIRECTORY}/dsl-tools.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} %replace([%X{karpfen.file}] ){'\[\] ', ''}- %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.karpfen.dsl" level="DEBUG" additivity="false">
        <appender-ref ref="DSL_TOOLS_FILE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>

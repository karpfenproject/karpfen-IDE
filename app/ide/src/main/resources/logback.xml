<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging of the karpfen IDE. This is its only logging configuration.

  The IDE's own logging goes to two places. WARN and above go to the console, on standard error. INFO and above go to
  the rolling file <IDE home>/logs/ide.log. The IDE home is the system property karpfen.ide.home, which the app's main
  sets from KARPFEN_IDE_HOME before the first logger exists. Without it, the home is ~/.karpfen-ide. SettingsLocations
  reads the same property, so the settings and the log always move together. The launch smoke tests use this to run
  with a temporary home.

  What karpfen-dsl-tools logs never reaches the console. It logs below the logger io.karpfen.dsl, which
  DslToolsLoggers names. That logger logs at DEBUG and passes nothing on to the root logger. Every event goes to the
  rolling file <IDE home>/logs/dsl-tools.log. The warnings and errors are also forwarded to ide.log, where
  DslToolsThresholdFilter holds back the rest. At runtime the composition root attaches one more appender to the same
  logger through LanguageToolsLogRouting. It fills the workbench's Language Tools Output, which is shown on demand.

  While dsl-tools reads a file, the mapped diagnostic context names that file under the key karpfen.file, which
  DslToolsLoggers names. Both log files write the file in brackets after the logger. For an event without a file they
  leave the brackets out.

  Tests use the console-only src/test/resources/logback-test.xml instead.
-->
<configuration>
    <variable name="IDE_HOME" value="${karpfen.ide.home:-${user.home}/.karpfen-ide}"/>
    <variable name="LOG_DIRECTORY" value="${IDE_HOME}/logs"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIRECTORY}/ide.log</file>
        <filter class="io.karpfen.ide.app.logging.DslToolsThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIRECTORY}/ide.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} %replace([%X{karpfen.file}] ){'\[\] ', ''}- %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="DSL_TOOLS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIRECTORY}/dsl-tools.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIRECTORY}/dsl-tools.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} %replace([%X{karpfen.file}] ){'\[\] ', ''}- %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.karpfen.dsl" level="DEBUG" additivity="false">
        <appender-ref ref="DSL_TOOLS_FILE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
